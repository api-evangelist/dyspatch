{
  "opencollection": "1.0.0",
  "info": {
    "name": "Dyspatch Blocks Push Localizations API",
    "version": "2026.06"
  },
  "items": [
    {
      "info": {
        "name": "Push Localizations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Push Localization Object by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.dyspatch.io/push/localizations/:localizationId",
            "headers": [
              {
                "name": "Accept",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "localizationId",
                "value": "",
                "type": "path",
                "description": "A localization ID"
              },
              {
                "name": "targetLanguage",
                "value": "",
                "type": "query",
                "description": "The type of templating language to use when compiling the content."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Returns the published Push content associated with the localization of the matching ID"
        },
        {
          "info": {
            "name": "Get Push Draft Localization Object by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.dyspatch.io/push/localizations/:localizationId/drafts/:draftId",
            "headers": [
              {
                "name": "Accept",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "draftId",
                "value": "",
                "type": "path",
                "description": "A draft ID"
              },
              {
                "name": "localizationId",
                "value": "",
                "type": "path",
                "description": "A localization ID"
              },
              {
                "name": "targetLanguage",
                "value": "",
                "type": "query",
                "description": "The type of templating language to use when compiling the content."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Returns a specific localization object of the matching Push draft with a matching localization ID"
        }
      ]
    }
  ],
  "bundled": true
}