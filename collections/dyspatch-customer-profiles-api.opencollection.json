            "url": "https://api.dyspatch.io/customerprofiles/:customerProfileId",
            "headers": [
              {
                "name": "Accept",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "customerProfileId",
                "value": "",
                "type": "path",
                "description": "A customer profile ID"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Returns a customer profile object with the matching ID, including its JSON data content and workspace association."
